# Copy this file to .env.local for local development.
# Social login and AI keys are optional. The app works offline with 20 built-in facts.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Identity Services or Firebase Google sign-in
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Apple Sign-In (Service ID)
NEXT_PUBLIC_APPLE_CLIENT_ID=
NEXT_PUBLIC_APPLE_REDIRECT_URI=http://localhost:3000

# Optional Firebase Auth
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: point a Capacitor native shell at a hosted server
# CAPACITOR_SERVER_URL=https://your-domain.example
