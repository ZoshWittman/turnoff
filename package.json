    "@supabase/supabase-js": "^2.116.0",
    "ai": "^7.0.97",
    "firebase": "^12.19.0",
    "framer-motion": "^13.2.0",
    "lucide-react": "^1.44.0",
    "next": "16.3.4",
    "onnxruntime-web": "1.18.0",
